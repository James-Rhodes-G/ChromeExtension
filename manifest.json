{
    "manifest_version": 3,
    "name": "PS Tools",
    "version": "0.0.0.5",
    "description": "Tools for Genesys Pro Serv Team Members",
    "permissions": [
        "activeTab",
        "tabs",
        "storage",
        "webRequest",
        "scripting",
        "webNavigation",
        "sidePanel"
    ],
    "options_page": "options.html",
    "host_permissions": [
        "https://*.apne3.pure.cloud/*",
        "https://*.apne2.pure.cloud/*",
        "https://*.mypurecloud.com.au/*",
        "https://*.mypurecloud.jp/*",
        "https://*.cac1.pure.cloud/*",
        "https://*.mypurecloud.de/*",
        "https://*.mypurecloud.ie/*",
        "https://*.euw2.pure.cloud/*",
        "https://*.euc2.pure.cloud/*",
        "https://*.mec1.pure.cloud/*",
        "https://*.sae1.pure.cloud/*",
        "https://*.mypurecloud.com/*",
        "https://*.use2.us-gov-pure.cloud/*",
        "https://*.usw2.pure.cloud/*"
    ],
    "action": {
        
        "default_title": "Genesys Tools"
    },
    "background": {
        "service_worker": "background.js",
        "type":"module"
    },
    "icons": {
        "16": "./ExtensionLogo/adaptive-g-orange_16.png",
        "48": "./ExtensionLogo/adaptive-g-orange_48.png",
        "32": "./ExtensionLogo/adaptive-g-orange_32.png",
        "128": "./ExtensionLogo/adaptive-g-orange_128.png"
    },
    "content_scripts": [
        {
          "matches": [
            "https://*.apne3.pure.cloud/*",
            "https://*.apne2.pure.cloud/*",
            "https://*.mypurecloud.com.au/*",
            "https://*.mypurecloud.jp/*",
            "https://*.cac1.pure.cloud/*",
            "https://*.mypurecloud.de/*",
            "https://*.mypurecloud.ie/*",
            "https://*.euw2.pure.cloud/*",
            "https://*.euc2.pure.cloud/*",
            "https://*.mec1.pure.cloud/*",
            "https://*.sae1.pure.cloud/*",
            "https://*.mypurecloud.com/*",
            "https://*.use2.us-gov-pure.cloud/*",
            "https://*.usw2.pure.cloud/*"
        ],
          "js": ["./js/analyticsListener.js"
            ],
         "run_at":"document_idle",
         "all_frames": true
        }
      ],
    "web_accessible_resources": [{
        "matches": [            
            "https://*.apne3.pure.cloud/*",
            "https://*.apne2.pure.cloud/*",
            "https://*.mypurecloud.com.au/*",
            "https://*.mypurecloud.jp/*",
            "https://*.cac1.pure.cloud/*",
            "https://*.mypurecloud.de/*",
            "https://*.mypurecloud.ie/*",
            "https://*.euw2.pure.cloud/*",
            "https://*.euc2.pure.cloud/*",
            "https://*.mec1.pure.cloud/*",
            "https://*.sae1.pure.cloud/*",
            "https://*.mypurecloud.com/*",
            "https://*.use2.us-gov-pure.cloud/*",
            "https://*.usw2.pure.cloud/*"
        ],
        "resources": [  "sidepanel.js",
                "./js/utils.js",
                "./js/passwordReset.js",
                "./js/log.js",
                "./js/inline.js",
                "./js/queues.js",
                "./js/loadSchedules.js",
                "./js/skills.js",
                "./js/prompts.js",
                "./js/bulkExport.js",
                "./js/disconnect.js",
                "./js/options.js",
                "./js/flowExecution.js"
                    ]
      }],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval';",
        "sandbox":"sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';",
        "object-src": "'self'"
    }
}